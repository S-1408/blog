# Canonical public URL of the blog, INCLUDING the base path when served as a zone,
# e.g. https://example.com/blog. Used for metadata, sitemap and robots.
# Local development falls back to http://localhost:3001.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Multi-Zones: serve the blog under a sub-path, e.g. /blog. Leave empty to serve at the root.
NEXT_PUBLIC_BASE_PATH=

# Shows the "Say hello" links when set.
NEXT_PUBLIC_CONTACT_EMAIL=

# Blog API base URL (server-only; never sent to the browser). Required at build time and runtime.
API_URL=http://localhost:4000
# Optional request timeout for API calls, in milliseconds.
# API_TIMEOUT_MS=8000

# Shared secret for POST /api/revalidate. Must equal REVALIDATE_SECRET in the API's .env.
REVALIDATE_SECRET=replace-with-another-long-random-secret
